# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_ROOT_PASSWORD=root
# Docker 里 MySQL 数据在宿主机上的目录。相对路径相对于项目根目录。
# NAS 单独建目录
MYSQL_DATA_DIR=./data/mysql

# 接口
PORT=3001
JWT_SECRET=bonnote-dev-secret-change-me

# 邮件。SMTP_HOST 留空时不发信，验证码会显示在页面上。
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# 网页。本地开发用 5173。NAS 上改成未占用的端口，例如 8081，避开 bonmanage 的 8080。
WEB_HOST=
WEB_PORT=

# 演示账号。只有 SEED_DEMO=true 时，npm run setup 才会写入，登录页也才会出现入口。
# 部署时把 SEED_DEMO 留空。本地试用改为 true。
SEED_DEMO=
DEMO_EMAIL=
DEMO_PASSWORD=
